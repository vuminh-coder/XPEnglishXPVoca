{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 13960,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "The human voice:"
    } ]
  }, {
    "tStartMs": 16070,
    "dDurationMs": 1564,
    "segs": [ {
      "utf8": "It's the instrument we all play."
    } ]
  }, {
    "tStartMs": 18610,
    "dDurationMs": 2459,
    "segs": [ {
      "utf8": "It's the most powerful sound\nin the world, probably."
    } ]
  }, {
    "tStartMs": 21093,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "It's the only one that can start a war\nor say \"I love you.\""
    } ]
  }, {
    "tStartMs": 23940,
    "dDurationMs": 1858,
    "segs": [ {
      "utf8": "And yet many people have the experience"
    } ]
  }, {
    "tStartMs": 25822,
    "dDurationMs": 2364,
    "segs": [ {
      "utf8": "that when they speak, people\ndon't listen to them."
    } ]
  }, {
    "tStartMs": 28210,
    "dDurationMs": 1112,
    "segs": [ {
      "utf8": "And why is that?"
    } ]
  }, {
    "tStartMs": 29346,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "How can we speak powerfully\nto make change in the world?"
    } ]
  }, {
    "tStartMs": 33485,
    "dDurationMs": 1312,
    "segs": [ {
      "utf8": "What I'd like to suggest,"
    } ]
  }, {
    "tStartMs": 34821,
    "dDurationMs": 2845,
    "segs": [ {
      "utf8": "there are a number of habits\nthat we need to move away from."
    } ]
  }, {
    "tStartMs": 37690,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "I've assembled for your pleasure here\nseven deadly sins of speaking."
    } ]
  }, {
    "tStartMs": 41444,
    "dDurationMs": 2408,
    "segs": [ {
      "utf8": "I'm not pretending\nthis is an exhaustive list,"
    } ]
  }, {
    "tStartMs": 43876,
    "dDurationMs": 5232,
    "segs": [ {
      "utf8": "but these seven, I think, are pretty large\nhabits that we can all fall into."
    } ]
  }, {
    "tStartMs": 49132,
    "dDurationMs": 2007,
    "segs": [ {
      "utf8": "First, gossip."
    } ]
  }, {
    "tStartMs": 51989,
    "dDurationMs": 2108,
    "segs": [ {
      "utf8": "Speaking ill of somebody\nwho's not present."
    } ]
  }, {
    "tStartMs": 54700,
    "dDurationMs": 2096,
    "segs": [ {
      "utf8": "Not a nice habit,\nand we know perfectly well"
    } ]
  }, {
    "tStartMs": 56820,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "the person gossiping, five minutes later,\nwill be gossiping about us."
    } ]
  }, {
    "tStartMs": 61771,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Second, judging."
    } ]
  }, {
    "tStartMs": 63515,
    "dDurationMs": 2384,
    "segs": [ {
      "utf8": "We know people who are like this\nin conversation,"
    } ]
  }, {
    "tStartMs": 65923,
    "dDurationMs": 1932,
    "segs": [ {
      "utf8": "and it's very hard to listen to somebody"
    } ]
  }, {
    "tStartMs": 67879,
    "dDurationMs": 4126,
    "segs": [ {
      "utf8": "if you know that you're being judged\nand found wanting at the same time."
    } ]
  }, {
    "tStartMs": 72029,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "Third, negativity."
    } ]
  }, {
    "tStartMs": 74447,
    "dDurationMs": 1288,
    "segs": [ {
      "utf8": "You can fall into this."
    } ]
  }, {
    "tStartMs": 75759,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "My mother, in the last years of her life,\nbecame very negative,"
    } ]
  }, {
    "tStartMs": 78820,
    "dDurationMs": 1322,
    "segs": [ {
      "utf8": "and it's hard to listen."
    } ]
  }, {
    "tStartMs": 80166,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "I remember one day, I said to her,\n\"It's October 1 today,\""
    } ]
  }, {
    "tStartMs": 82923,
    "dDurationMs": 2093,
    "segs": [ {
      "utf8": "and she said, \"I know, isn't it dreadful?\""
    } ]
  }, {
    "tStartMs": 85040,
    "dDurationMs": 2198,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 87262,
    "dDurationMs": 2349,
    "segs": [ {
      "utf8": "It's hard to listen\nwhen somebody's that negative."
    } ]
  }, {
    "tStartMs": 89635,
    "dDurationMs": 1272,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 90931,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And another form\nof negativity, complaining."
    } ]
  }, {
    "tStartMs": 93475,
    "dDurationMs": 4043,
    "segs": [ {
      "utf8": "Well, this is the national art of the U.K."
    } ]
  }, {
    "tStartMs": 97542,
    "dDurationMs": 1411,
    "segs": [ {
      "utf8": "It's our national sport."
    } ]
  }, {
    "tStartMs": 98977,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "We complain about the weather, sport,\nabout politics, about everything,"
    } ]
  }, {
    "tStartMs": 102435,
    "dDurationMs": 2096,
    "segs": [ {
      "utf8": "but actually, complaining is viral misery."
    } ]
  }, {
    "tStartMs": 104555,
    "dDurationMs": 2632,
    "segs": [ {
      "utf8": "It's not spreading sunshine\nand lightness in the world."
    } ]
  }, {
    "tStartMs": 108292,
    "dDurationMs": 1732,
    "segs": [ {
      "utf8": "Excuses."
    } ]
  }, {
    "tStartMs": 110048,
    "dDurationMs": 1324,
    "segs": [ {
      "utf8": "We've all met this guy."
    } ]
  }, {
    "tStartMs": 111396,
    "dDurationMs": 1576,
    "segs": [ {
      "utf8": "Maybe we've all been this guy."
    } ]
  }, {
    "tStartMs": 112996,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "Some people have a blamethrower."
    } ]
  }, {
    "tStartMs": 115490,
    "dDurationMs": 2204,
    "segs": [ {
      "utf8": "They just pass it on to everybody else"
    } ]
  }, {
    "tStartMs": 117718,
    "dDurationMs": 2304,
    "segs": [ {
      "utf8": "and don't take responsibility\nfor their actions,"
    } ]
  }, {
    "tStartMs": 120046,
    "dDurationMs": 2912,
    "segs": [ {
      "utf8": "and again, hard to listen\nto somebody who is being like that."
    } ]
  }, {
    "tStartMs": 122982,
    "dDurationMs": 1798,
    "segs": [ {
      "utf8": "Penultimate, the sixth of the seven,"
    } ]
  }, {
    "tStartMs": 124804,
    "dDurationMs": 3382,
    "segs": [ {
      "utf8": "embroidery, exaggeration."
    } ]
  }, {
    "tStartMs": 128210,
    "dDurationMs": 2404,
    "segs": [ {
      "utf8": "It demeans our language,\nactually, sometimes."
    } ]
  }, {
    "tStartMs": 130638,
    "dDurationMs": 3268,
    "segs": [ {
      "utf8": "For example, if I see something\nthat really is awesome,"
    } ]
  }, {
    "tStartMs": 133930,
    "dDurationMs": 1266,
    "segs": [ {
      "utf8": "what do I call it?"
    } ]
  }, {
    "tStartMs": 135220,
    "dDurationMs": 2596,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 137840,
    "dDurationMs": 3436,
    "segs": [ {
      "utf8": "And then, of course,\nthis exaggeration becomes lying,"
    } ]
  }, {
    "tStartMs": 141300,
    "dDurationMs": 2999,
    "segs": [ {
      "utf8": "and we don't want to listen\nto people we know are lying to us."
    } ]
  }, {
    "tStartMs": 144323,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And finally, dogmatism."
    } ]
  }, {
    "tStartMs": 147688,
    "dDurationMs": 3611,
    "segs": [ {
      "utf8": "The confusion of facts with opinions."
    } ]
  }, {
    "tStartMs": 151323,
    "dDurationMs": 1915,
    "segs": [ {
      "utf8": "When those two things get conflated,"
    } ]
  }, {
    "tStartMs": 153262,
    "dDurationMs": 1477,
    "segs": [ {
      "utf8": "you're listening into the wind."
    } ]
  }, {
    "tStartMs": 154763,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "You know, somebody is bombarding you\nwith their opinions as if they were true."
    } ]
  }, {
    "tStartMs": 158454,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "It's difficult to listen to that."
    } ]
  }, {
    "tStartMs": 160547,
    "dDurationMs": 3017,
    "segs": [ {
      "utf8": "So here they are, seven deadly\nsins of speaking."
    } ]
  }, {
    "tStartMs": 163588,
    "dDurationMs": 2409,
    "segs": [ {
      "utf8": "These are things I think we need to avoid."
    } ]
  }, {
    "tStartMs": 166021,
    "dDurationMs": 2845,
    "segs": [ {
      "utf8": "But is there a positive\nway to think about this?"
    } ]
  }, {
    "tStartMs": 168890,
    "dDurationMs": 1259,
    "segs": [ {
      "utf8": "Yes, there is."
    } ]
  }, {
    "tStartMs": 170458,
    "dDurationMs": 5492,
    "segs": [ {
      "utf8": "I'd like to suggest that there are four\nreally powerful cornerstones, foundations,"
    } ]
  }, {
    "tStartMs": 175974,
    "dDurationMs": 2422,
    "segs": [ {
      "utf8": "that we can stand on if we want our speech"
    } ]
  }, {
    "tStartMs": 178420,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "to be powerful and to make\nchange in the world."
    } ]
  }, {
    "tStartMs": 182288,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "Fortunately, these things spell a word."
    } ]
  }, {
    "tStartMs": 184523,
    "dDurationMs": 3072,
    "segs": [ {
      "utf8": "The word is \"hail,\" and it has\na great definition as well."
    } ]
  }, {
    "tStartMs": 187619,
    "dDurationMs": 2644,
    "segs": [ {
      "utf8": "I'm not talking about the stuff\nthat falls from the sky"
    } ]
  }, {
    "tStartMs": 190287,
    "dDurationMs": 1264,
    "segs": [ {
      "utf8": "and hits you on the head."
    } ]
  }, {
    "tStartMs": 191575,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I'm talking about this definition,"
    } ]
  }, {
    "tStartMs": 193219,
    "dDurationMs": 1797,
    "segs": [ {
      "utf8": "to greet or acclaim enthusiastically,"
    } ]
  }, {
    "tStartMs": 195040,
    "dDurationMs": 2243,
    "segs": [ {
      "utf8": "which is how I think\nour words will be received"
    } ]
  }, {
    "tStartMs": 197307,
    "dDurationMs": 1572,
    "segs": [ {
      "utf8": "if we stand on these four things."
    } ]
  }, {
    "tStartMs": 198903,
    "dDurationMs": 1498,
    "segs": [ {
      "utf8": "So what do they stand for?"
    } ]
  }, {
    "tStartMs": 200425,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "See if you can guess."
    } ]
  }, {
    "tStartMs": 202320,
    "dDurationMs": 2939,
    "segs": [ {
      "utf8": "The H, honesty, of course,"
    } ]
  }, {
    "tStartMs": 205283,
    "dDurationMs": 2947,
    "segs": [ {
      "utf8": "being true in what you say,\nbeing straight and clear."
    } ]
  }, {
    "tStartMs": 208254,
    "dDurationMs": 4017,
    "segs": [ {
      "utf8": "The A is authenticity,\njust being yourself."
    } ]
  }, {
    "tStartMs": 212295,
    "dDurationMs": 3186,
    "segs": [ {
      "utf8": "A friend of mine described it as\nstanding in your own truth,"
    } ]
  }, {
    "tStartMs": 215505,
    "dDurationMs": 1914,
    "segs": [ {
      "utf8": "which I think is a lovely way to put it."
    } ]
  }, {
    "tStartMs": 217443,
    "dDurationMs": 2612,
    "segs": [ {
      "utf8": "The I is integrity, being your word,"
    } ]
  }, {
    "tStartMs": 220079,
    "dDurationMs": 1764,
    "segs": [ {
      "utf8": "actually doing what you say,"
    } ]
  }, {
    "tStartMs": 221867,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "and being somebody people can trust."
    } ]
  }, {
    "tStartMs": 224358,
    "dDurationMs": 1997,
    "segs": [ {
      "utf8": "And the L is love."
    } ]
  }, {
    "tStartMs": 227130,
    "dDurationMs": 2097,
    "segs": [ {
      "utf8": "I don't mean romantic love,"
    } ]
  }, {
    "tStartMs": 229251,
    "dDurationMs": 3385,
    "segs": [ {
      "utf8": "but I do mean wishing people\nwell, for two reasons."
    } ]
  }, {
    "tStartMs": 232660,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "First of all, I think absolute honesty\nmay not be what we want."
    } ]
  }, {
    "tStartMs": 236074,
    "dDurationMs": 2565,
    "segs": [ {
      "utf8": "I mean, my goodness,\nyou look ugly this morning."
    } ]
  }, {
    "tStartMs": 238663,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "Perhaps that's not necessary."
    } ]
  }, {
    "tStartMs": 242021,
    "dDurationMs": 3334,
    "segs": [ {
      "utf8": "Tempered with love, of course,\nhonesty is a great thing."
    } ]
  }, {
    "tStartMs": 245379,
    "dDurationMs": 3071,
    "segs": [ {
      "utf8": "But also, if you're really\nwishing somebody well,"
    } ]
  }, {
    "tStartMs": 248474,
    "dDurationMs": 2613,
    "segs": [ {
      "utf8": "it's very hard to judge\nthem at the same time."
    } ]
  }, {
    "tStartMs": 251111,
    "dDurationMs": 3562,
    "segs": [ {
      "utf8": "I'm not even sure you can do\nthose two things simultaneously."
    } ]
  }, {
    "tStartMs": 255310,
    "dDurationMs": 1576,
    "segs": [ {
      "utf8": "So hail."
    } ]
  }, {
    "tStartMs": 256910,
    "dDurationMs": 1733,
    "segs": [ {
      "utf8": "Also, now that's what you say,"
    } ]
  }, {
    "tStartMs": 258667,
    "dDurationMs": 2244,
    "segs": [ {
      "utf8": "and it's like the old song,\nit is what you say,"
    } ]
  }, {
    "tStartMs": 260935,
    "dDurationMs": 1679,
    "segs": [ {
      "utf8": "it's also the way that you say it."
    } ]
  }, {
    "tStartMs": 262638,
    "dDurationMs": 1748,
    "segs": [ {
      "utf8": "You have an amazing toolbox."
    } ]
  }, {
    "tStartMs": 264410,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "This instrument is incredible,"
    } ]
  }, {
    "tStartMs": 266270,
    "dDurationMs": 3516,
    "segs": [ {
      "utf8": "and yet this is a toolbox\nthat very few people have ever opened."
    } ]
  }, {
    "tStartMs": 269810,
    "dDurationMs": 2597,
    "segs": [ {
      "utf8": "I'd like to have a little rummage\nin there with you now"
    } ]
  }, {
    "tStartMs": 272431,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "and just pull a few tools out"
    } ]
  }, {
    "tStartMs": 273855,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "that you might like to take\naway and play with,"
    } ]
  }, {
    "tStartMs": 276118,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "which will increase\nthe power of your speaking."
    } ]
  }, {
    "tStartMs": 278442,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Register, for example."
    } ]
  }, {
    "tStartMs": 279986,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "Now, falsetto register may not\nbe very useful most of the time,"
    } ]
  }, {
    "tStartMs": 284180,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "but there's a register in between."
    } ]
  }, {
    "tStartMs": 286234,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "I'm not going to get very\ntechnical about this"
    } ]
  }, {
    "tStartMs": 288419,
    "dDurationMs": 1762,
    "segs": [ {
      "utf8": "for any of you who are voice coaches."
    } ]
  }, {
    "tStartMs": 290205,
    "dDurationMs": 1713,
    "segs": [ {
      "utf8": "You can locate your voice, however."
    } ]
  }, {
    "tStartMs": 291942,
    "dDurationMs": 2858,
    "segs": [ {
      "utf8": "So if I talk up here in my nose,\nyou can hear the difference."
    } ]
  }, {
    "tStartMs": 294824,
    "dDurationMs": 1484,
    "segs": [ {
      "utf8": "If I go down here in my throat,"
    } ]
  }, {
    "tStartMs": 296332,
    "dDurationMs": 2629,
    "segs": [ {
      "utf8": "which is where most of us\nspeak from most of the time."
    } ]
  }, {
    "tStartMs": 298985,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "But if you want weight,"
    } ]
  }, {
    "tStartMs": 300642,
    "dDurationMs": 2454,
    "segs": [ {
      "utf8": "you need to go down here to the chest."
    } ]
  }, {
    "tStartMs": 303120,
    "dDurationMs": 1586,
    "segs": [ {
      "utf8": "You hear the difference?"
    } ]
  }, {
    "tStartMs": 304730,
    "dDurationMs": 4016,
    "segs": [ {
      "utf8": "We vote for politicians\nwith lower voices, it's true,"
    } ]
  }, {
    "tStartMs": 308770,
    "dDurationMs": 2944,
    "segs": [ {
      "utf8": "because we associate depth with power"
    } ]
  }, {
    "tStartMs": 311738,
    "dDurationMs": 1762,
    "segs": [ {
      "utf8": "and with authority."
    } ]
  }, {
    "tStartMs": 314445,
    "dDurationMs": 1367,
    "segs": [ {
      "utf8": "That's register."
    } ]
  }, {
    "tStartMs": 316134,
    "dDurationMs": 1343,
    "segs": [ {
      "utf8": "Then we have timbre."
    } ]
  }, {
    "tStartMs": 317501,
    "dDurationMs": 1745,
    "segs": [ {
      "utf8": "It's the way your voice feels."
    } ]
  }, {
    "tStartMs": 319270,
    "dDurationMs": 1332,
    "segs": [ {
      "utf8": "Again, the research shows"
    } ]
  }, {
    "tStartMs": 320626,
    "dDurationMs": 3774,
    "segs": [ {
      "utf8": "that we prefer voices\nwhich are rich, smooth, warm,"
    } ]
  }, {
    "tStartMs": 324424,
    "dDurationMs": 1486,
    "segs": [ {
      "utf8": "like hot chocolate."
    } ]
  }, {
    "tStartMs": 326635,
    "dDurationMs": 3264,
    "segs": [ {
      "utf8": "Well if that's not you,\nthat's not the end of the world,"
    } ]
  }, {
    "tStartMs": 329923,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "because you can train."
    } ]
  }, {
    "tStartMs": 331365,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "Go and get a voice coach."
    } ]
  }, {
    "tStartMs": 332609,
    "dDurationMs": 1858,
    "segs": [ {
      "utf8": "And there are amazing things you can do"
    } ]
  }, {
    "tStartMs": 334491,
    "dDurationMs": 2406,
    "segs": [ {
      "utf8": "with breathing, with posture,\nand with exercises"
    } ]
  }, {
    "tStartMs": 336921,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to improve the timbre of your voice."
    } ]
  }, {
    "tStartMs": 339435,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "Then prosody. I love prosody."
    } ]
  }, {
    "tStartMs": 341227,
    "dDurationMs": 2152,
    "segs": [ {
      "utf8": "This is the sing-song, the meta-language"
    } ]
  }, {
    "tStartMs": 343403,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "that we use in order to impart meaning."
    } ]
  }, {
    "tStartMs": 345477,
    "dDurationMs": 2814,
    "segs": [ {
      "utf8": "It's root one for meaning in conversation."
    } ]
  }, {
    "tStartMs": 348315,
    "dDurationMs": 4056,
    "segs": [ {
      "utf8": "People who speak all on one note\nare really quite hard to listen to"
    } ]
  }, {
    "tStartMs": 352395,
    "dDurationMs": 2192,
    "segs": [ {
      "utf8": "if they don't have any prosody at all."
    } ]
  }, {
    "tStartMs": 354611,
    "dDurationMs": 2951,
    "segs": [ {
      "utf8": "That's where the word\n\"monotonic\" comes from,"
    } ]
  }, {
    "tStartMs": 357586,
    "dDurationMs": 1937,
    "segs": [ {
      "utf8": "or monotonous, monotone."
    } ]
  }, {
    "tStartMs": 360306,
    "dDurationMs": 3273,
    "segs": [ {
      "utf8": "Also, we have repetitive\nprosody now coming in,"
    } ]
  }, {
    "tStartMs": 363603,
    "dDurationMs": 2696,
    "segs": [ {
      "utf8": "where every sentence ends\nas if it were a question"
    } ]
  }, {
    "tStartMs": 366323,
    "dDurationMs": 2477,
    "segs": [ {
      "utf8": "when it's actually not\na question, it's a statement?"
    } ]
  }, {
    "tStartMs": 368824,
    "dDurationMs": 2306,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 371154,
    "dDurationMs": 1562,
    "segs": [ {
      "utf8": "And if you repeat that one,"
    } ]
  }, {
    "tStartMs": 372740,
    "dDurationMs": 3344,
    "segs": [ {
      "utf8": "it's actually restricting your ability\nto communicate through prosody,"
    } ]
  }, {
    "tStartMs": 376108,
    "dDurationMs": 1862,
    "segs": [ {
      "utf8": "which I think is a shame,"
    } ]
  }, {
    "tStartMs": 377994,
    "dDurationMs": 1985,
    "segs": [ {
      "utf8": "so let's try and break that habit."
    } ]
  }, {
    "tStartMs": 381315,
    "dDurationMs": 1079,
    "segs": [ {
      "utf8": "Pace."
    } ]
  }, {
    "tStartMs": 382418,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "I can get very excited by saying\nsomething really quickly,"
    } ]
  }, {
    "tStartMs": 385203,
    "dDurationMs": 3352,
    "segs": [ {
      "utf8": "or I can slow right down to emphasize,"
    } ]
  }, {
    "tStartMs": 388579,
    "dDurationMs": 3616,
    "segs": [ {
      "utf8": "and at the end of that, of course,\nis our old friend silence."
    } ]
  }, {
    "tStartMs": 394555,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "There's nothing wrong with a bit\nof silence in a talk, is there?"
    } ]
  }, {
    "tStartMs": 398561,
    "dDurationMs": 2439,
    "segs": [ {
      "utf8": "We don't have to fill it with ums and ahs."
    } ]
  }, {
    "tStartMs": 401833,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "It can be very powerful."
    } ]
  }, {
    "tStartMs": 403823,
    "dDurationMs": 2304,
    "segs": [ {
      "utf8": "Of course, pitch often\ngoes along with pace"
    } ]
  }, {
    "tStartMs": 406151,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "to indicate arousal, but you\ncan do it just with pitch."
    } ]
  }, {
    "tStartMs": 408795,
    "dDurationMs": 1564,
    "segs": [ {
      "utf8": "Where did you leave my keys?"
    } ]
  }, {
    "tStartMs": 410383,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "(Higher pitch) Where did you\nleave my keys?"
    } ]
  }, {
    "tStartMs": 412487,
    "dDurationMs": 3645,
    "segs": [ {
      "utf8": "So, slightly different meaning\nin those two deliveries."
    } ]
  }, {
    "tStartMs": 416156,
    "dDurationMs": 2222,
    "segs": [ {
      "utf8": "And finally, volume."
    } ]
  }, {
    "tStartMs": 418402,
    "dDurationMs": 3377,
    "segs": [ {
      "utf8": "(Loud) I can get really excited\nby using volume."
    } ]
  }, {
    "tStartMs": 421803,
    "dDurationMs": 2153,
    "segs": [ {
      "utf8": "Sorry about that, if I startled anybody."
    } ]
  }, {
    "tStartMs": 423980,
    "dDurationMs": 3523,
    "segs": [ {
      "utf8": "Or, I can have you really pay attention\nby getting very quiet."
    } ]
  }, {
    "tStartMs": 428707,
    "dDurationMs": 1796,
    "segs": [ {
      "utf8": "Some people broadcast the whole time."
    } ]
  }, {
    "tStartMs": 430527,
    "dDurationMs": 1349,
    "segs": [ {
      "utf8": "Try not to do that."
    } ]
  }, {
    "tStartMs": 431900,
    "dDurationMs": 1828,
    "segs": [ {
      "utf8": "That's called sodcasting,"
    } ]
  }, {
    "tStartMs": 433752,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 435445,
    "dDurationMs": 4544,
    "segs": [ {
      "utf8": "Imposing your sound on people around you\ncarelessly and inconsiderately."
    } ]
  }, {
    "tStartMs": 440013,
    "dDurationMs": 1078,
    "segs": [ {
      "utf8": "Not nice."
    } ]
  }, {
    "tStartMs": 441115,
    "dDurationMs": 2532,
    "segs": [ {
      "utf8": "Of course, where this all comes\ninto play most of all"
    } ]
  }, {
    "tStartMs": 443671,
    "dDurationMs": 2504,
    "segs": [ {
      "utf8": "is when you've got something\nreally important to do."
    } ]
  }, {
    "tStartMs": 446199,
    "dDurationMs": 3428,
    "segs": [ {
      "utf8": "It might be standing on a stage like this\nand giving a talk to people."
    } ]
  }, {
    "tStartMs": 449651,
    "dDurationMs": 1864,
    "segs": [ {
      "utf8": "It might be proposing marriage,"
    } ]
  }, {
    "tStartMs": 451539,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "asking for a raise, a wedding speech."
    } ]
  }, {
    "tStartMs": 454693,
    "dDurationMs": 1982,
    "segs": [ {
      "utf8": "Whatever it is, if it's really important,"
    } ]
  }, {
    "tStartMs": 456699,
    "dDurationMs": 3749,
    "segs": [ {
      "utf8": "you owe it to yourself\nto look at this toolbox"
    } ]
  }, {
    "tStartMs": 460472,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "and the engine that it's going to work on,"
    } ]
  }, {
    "tStartMs": 462509,
    "dDurationMs": 3071,
    "segs": [ {
      "utf8": "and no engine works well\nwithout being warmed up."
    } ]
  }, {
    "tStartMs": 465604,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "Warm up your voice."
    } ]
  }, {
    "tStartMs": 467482,
    "dDurationMs": 2051,
    "segs": [ {
      "utf8": "Actually, let me show you how to do that."
    } ]
  }, {
    "tStartMs": 469557,
    "dDurationMs": 2955,
    "segs": [ {
      "utf8": "Would you all like to stand\nup for a moment?"
    } ]
  }, {
    "tStartMs": 472536,
    "dDurationMs": 1131,
    "segs": [ {
      "utf8": "I'm going to show you"
    } ]
  }, {
    "tStartMs": 473691,
    "dDurationMs": 5210,
    "segs": [ {
      "utf8": "the six vocal warm-up exercises\nthat I do before every talk I ever do."
    } ]
  }, {
    "tStartMs": 478925,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Any time you're going to talk\nto anybody important, do these."
    } ]
  }, {
    "tStartMs": 481859,
    "dDurationMs": 2779,
    "segs": [ {
      "utf8": "First, arms up, deep breath in,"
    } ]
  }, {
    "tStartMs": 484662,
    "dDurationMs": 3078,
    "segs": [ {
      "utf8": "and sigh out, ahhhhh, like that."
    } ]
  }, {
    "tStartMs": 487764,
    "dDurationMs": 1604,
    "segs": [ {
      "utf8": "One more time."
    } ]
  }, {
    "tStartMs": 489392,
    "dDurationMs": 2974,
    "segs": [ {
      "utf8": "Ahhhh, very good."
    } ]
  }, {
    "tStartMs": 492390,
    "dDurationMs": 1718,
    "segs": [ {
      "utf8": "Now we're going to warm up our lips,"
    } ]
  }, {
    "tStartMs": 494132,
    "dDurationMs": 2328,
    "segs": [ {
      "utf8": "and we're going to go Ba, Ba, Ba, Ba,"
    } ]
  }, {
    "tStartMs": 496484,
    "dDurationMs": 2928,
    "segs": [ {
      "utf8": "Ba, Ba, Ba, Ba. Very good."
    } ]
  }, {
    "tStartMs": 499436,
    "dDurationMs": 3416,
    "segs": [ {
      "utf8": "And now, brrrrrrrrrr,"
    } ]
  }, {
    "tStartMs": 502876,
    "dDurationMs": 1526,
    "segs": [ {
      "utf8": "just like when you were a kid."
    } ]
  }, {
    "tStartMs": 504426,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "Brrrr. Now your lips\nshould be coming alive."
    } ]
  }, {
    "tStartMs": 506853,
    "dDurationMs": 1651,
    "segs": [ {
      "utf8": "We're going to do the tongue next"
    } ]
  }, {
    "tStartMs": 508528,
    "dDurationMs": 4298,
    "segs": [ {
      "utf8": "with exaggerated la, la, la,\nla, la, la, la, la, la."
    } ]
  }, {
    "tStartMs": 512850,
    "dDurationMs": 2191,
    "segs": [ {
      "utf8": "Beautiful. You're getting\nreally good at this."
    } ]
  }, {
    "tStartMs": 515065,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "And then, roll an R. Rrrrrrr."
    } ]
  }, {
    "tStartMs": 517955,
    "dDurationMs": 2192,
    "segs": [ {
      "utf8": "That's like champagne for the tongue."
    } ]
  }, {
    "tStartMs": 520171,
    "dDurationMs": 2296,
    "segs": [ {
      "utf8": "Finally, and if I can only do one,"
    } ]
  }, {
    "tStartMs": 522491,
    "dDurationMs": 1783,
    "segs": [ {
      "utf8": "the pros call this the siren."
    } ]
  }, {
    "tStartMs": 524298,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "It's really good. It starts\nwith \"we\" and goes to \"aw.\""
    } ]
  }, {
    "tStartMs": 526942,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The \"we\" is high, the \"aw\" is low."
    } ]
  }, {
    "tStartMs": 528586,
    "dDurationMs": 6096,
    "segs": [ {
      "utf8": "So you go, weeeaawww, weeeaawww."
    } ]
  }, {
    "tStartMs": 534706,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "Fantastic. Give yourselves\na round of applause."
    } ]
  }, {
    "tStartMs": 536969,
    "dDurationMs": 1245,
    "segs": [ {
      "utf8": "Take a seat, thank you."
    } ]
  }, {
    "tStartMs": 538238,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "(Applause)"
    } ]
  }, {
    "tStartMs": 539712,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Next time you speak, do those in advance."
    } ]
  }, {
    "tStartMs": 542336,
    "dDurationMs": 2616,
    "segs": [ {
      "utf8": "Now let me just put this\nin context to close."
    } ]
  }, {
    "tStartMs": 544976,
    "dDurationMs": 2272,
    "segs": [ {
      "utf8": "This is a serious point here."
    } ]
  }, {
    "tStartMs": 547272,
    "dDurationMs": 1807,
    "segs": [ {
      "utf8": "This is where we are now, right?"
    } ]
  }, {
    "tStartMs": 549103,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "We speak not very well"
    } ]
  }, {
    "tStartMs": 550768,
    "dDurationMs": 1844,
    "segs": [ {
      "utf8": "to people who simply aren't listening"
    } ]
  }, {
    "tStartMs": 552636,
    "dDurationMs": 2895,
    "segs": [ {
      "utf8": "in an environment that's all\nabout noise and bad acoustics."
    } ]
  }, {
    "tStartMs": 555555,
    "dDurationMs": 3219,
    "segs": [ {
      "utf8": "I have talked about that on this stage\nin different phases."
    } ]
  }, {
    "tStartMs": 558798,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "What would the world be like"
    } ]
  }, {
    "tStartMs": 560432,
    "dDurationMs": 1696,
    "segs": [ {
      "utf8": "if we were speaking powerfully"
    } ]
  }, {
    "tStartMs": 562152,
    "dDurationMs": 2032,
    "segs": [ {
      "utf8": "to people who were listening consciously"
    } ]
  }, {
    "tStartMs": 564208,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "in environments which were\nactually fit for purpose?"
    } ]
  }, {
    "tStartMs": 567602,
    "dDurationMs": 2959,
    "segs": [ {
      "utf8": "Or to make that a bit larger,"
    } ]
  }, {
    "tStartMs": 570585,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "what would the world be like"
    } ]
  }, {
    "tStartMs": 571943,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "if we were creating sound consciously"
    } ]
  }, {
    "tStartMs": 574310,
    "dDurationMs": 2009,
    "segs": [ {
      "utf8": "and consuming sound consciously"
    } ]
  }, {
    "tStartMs": 576343,
    "dDurationMs": 1703,
    "segs": [ {
      "utf8": "and designing all our environments"
    } ]
  }, {
    "tStartMs": 578070,
    "dDurationMs": 1453,
    "segs": [ {
      "utf8": "consciously for sound?"
    } ]
  }, {
    "tStartMs": 579547,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "That would be a world\nthat does sound beautiful,"
    } ]
  }, {
    "tStartMs": 582671,
    "dDurationMs": 3887,
    "segs": [ {
      "utf8": "and one where understanding\nwould be the norm,"
    } ]
  }, {
    "tStartMs": 586582,
    "dDurationMs": 2649,
    "segs": [ {
      "utf8": "and that is an idea worth spreading."
    } ]
  }, {
    "tStartMs": 589255,
    "dDurationMs": 1132,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  }, {
    "tStartMs": 590411,
    "dDurationMs": 1522,
    "segs": [ {
      "utf8": "(Applause)"
    } ]
  } ]
}
