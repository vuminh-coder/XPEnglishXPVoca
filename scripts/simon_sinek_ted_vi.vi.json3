{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "Translator: Le Vu\nReviewer: Ha Tran"
    } ]
  }, {
    "tStartMs": 16257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Bạn giải thích như thế nào khi"
    } ]
  }, {
    "tStartMs": 18257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mọi việc không tiến triển như mong muốn?"
    } ]
  }, {
    "tStartMs": 20257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Dễ hiểu hơn, bạn giải thích như thế nào"
    } ]
  }, {
    "tStartMs": 23257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "khi những người khác có thể đạt được những thứ"
    } ]
  }, {
    "tStartMs": 25257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "dường như cưỡng lại mọi giả định?"
    } ]
  }, {
    "tStartMs": 27257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ví dụ:"
    } ]
  }, {
    "tStartMs": 29257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tại sao Apple lại quá sáng tạo?"
    } ]
  }, {
    "tStartMs": 31257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Năm này qua năm khác,"
    } ]
  }, {
    "tStartMs": 33257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "họ sáng tạo nhiều hơn tất cả những đối thủ của mình."
    } ]
  }, {
    "tStartMs": 36257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và vâng, họ chỉ là một công ty máy tính."
    } ]
  }, {
    "tStartMs": 38257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Họ cũng chỉ như những người khác."
    } ]
  }, {
    "tStartMs": 40257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Họ cũng cùng khả năng tiếp cận với cùng những tài năng,"
    } ]
  }, {
    "tStartMs": 42257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "cùng các nhà môi giới, cùng các cố vấn và cùng phương tiện truyền thông."
    } ]
  }, {
    "tStartMs": 45257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Vậy tại sao họ"
    } ]
  }, {
    "tStartMs": 47257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "có vẻ như có gì đó khác?"
    } ]
  }, {
    "tStartMs": 50257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tại sao rằng Martin Luther King"
    } ]
  }, {
    "tStartMs": 52257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "dẫn đầu Phong Trào Quyền Công Dân?"
    } ]
  }, {
    "tStartMs": 54257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ông không phải là người duy nhất"
    } ]
  }, {
    "tStartMs": 56257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "chịu khổ trong thời kỳ tiền quyền công dân của Mỹ trước đây."
    } ]
  }, {
    "tStartMs": 58257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và ông ta chắc chắn không phải nhà hùng biện tuyệt vời duy nhất thời đấy."
    } ]
  }, {
    "tStartMs": 60257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tại sao lại là ông ấy?"
    } ]
  }, {
    "tStartMs": 62257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và tại sao mà anh em nhà Wright"
    } ]
  }, {
    "tStartMs": 65257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "có khả năng nghĩ ra chuyến bay có người lái"
    } ]
  }, {
    "tStartMs": 68257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "khi mà ở đây chắc chắn có những nhóm nghiên cứu khác"
    } ]
  }, {
    "tStartMs": 70257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "trình độ cao hơn, được tài trợ nhiều hơn,"
    } ]
  }, {
    "tStartMs": 73257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "và họ không đạt được những chuyến bay do người điều khiển,"
    } ]
  }, {
    "tStartMs": 76257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và anh em nhà Wright đã hạ ngục họ trên chiến trường này."
    } ]
  }, {
    "tStartMs": 78257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Ở đây có thứ gì khác ở đây."
    } ]
  }, {
    "tStartMs": 81257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Khoảng ba năm rưỡi trước đây"
    } ]
  }, {
    "tStartMs": 83257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tôi đa khám phá ra,"
    } ]
  }, {
    "tStartMs": 85257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "và khám phá này đã thay đổi một cách sâu sắc"
    } ]
  }, {
    "tStartMs": 88257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "quan điểm của tôi về cái cách mà thế giới hoạt động."
    } ]
  }, {
    "tStartMs": 91257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và nó thậm chí thay đổi hoàn toàn cái cách mà"
    } ]
  }, {
    "tStartMs": 93257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "tôi hoạt động trong đó."
    } ]
  }, {
    "tStartMs": 97257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và nó cho thấy -- ở đây có một dạng --"
    } ]
  }, {
    "tStartMs": 100257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mà tất cả các nhà lãnh đạo vĩ đại và truyền cảm"
    } ]
  }, {
    "tStartMs": 102257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và những tổ chức trên thế giới,"
    } ]
  }, {
    "tStartMs": 104257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "cho dù nó là Apple, hay Martin Luther King và anh em nhà Wright"
    } ]
  }, {
    "tStartMs": 107257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "họ đều nghĩ, hành động và giao tiếp"
    } ]
  }, {
    "tStartMs": 109257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "chính xác cùng một cách."
    } ]
  }, {
    "tStartMs": 111257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và nó hoàn toàn đối lập với"
    } ]
  }, {
    "tStartMs": 113257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "với những người khác"
    } ]
  }, {
    "tStartMs": 115257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tất cả những gì tôi làm là hệ thống hóa nó."
    } ]
  }, {
    "tStartMs": 117257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và nó hầu như chắc chắn là"
    } ]
  }, {
    "tStartMs": 119257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "ý tưởng đơn giản nhất thế giới."
    } ]
  }, {
    "tStartMs": 121257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tôi gọi nó là Vòng Tròn Vàng."
    } ]
  }, {
    "tStartMs": 131257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Tại sao? Như thế nào? Cái gì?"
    } ]
  }, {
    "tStartMs": 134257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Cái ý tưởng nhỏ đó giải thích"
    } ]
  }, {
    "tStartMs": 136257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "tại sao một vài tổ chức và vài nhà lãnh đạo"
    } ]
  }, {
    "tStartMs": 138257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "có khả năng truyền cảm hứng trong khi những người khác thì không"
    } ]
  }, {
    "tStartMs": 140257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Để tôi định nghĩa nó thật nhanh."
    } ]
  }, {
    "tStartMs": 142257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Mỗi một cá nhân, một tổ chức trên hành tinh này"
    } ]
  }, {
    "tStartMs": 145257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "biết họ nên làm gì,"
    } ]
  }, {
    "tStartMs": 147257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "100 phần trăm."
    } ]
  }, {
    "tStartMs": 149257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Một vài biết nên làm nó như thế nào,"
    } ]
  }, {
    "tStartMs": 151257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "chò dù bạn goi nó là kế hoạch khác biệt về giá trị của bạn"
    } ]
  }, {
    "tStartMs": 153257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "hay sự tiến trình độc quyền của bạn hay đặc trưng riêng của bạn (USP)"
    } ]
  }, {
    "tStartMs": 156257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nhưng rất, rất ít người hay tổ chức"
    } ]
  }, {
    "tStartMs": 159257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "biết tại sao họ làm điều mà họ làm."
    } ]
  }, {
    "tStartMs": 161257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và khi nói \"Tại sao\" tôi không có ý nói đến ''tạo ra lợi nhuận.\""
    } ]
  }, {
    "tStartMs": 163257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Đó là kết quả. Nó luôn luôn là kết quả."
    } ]
  }, {
    "tStartMs": 165257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Khi nói \"tại sao\" thì ý tôi là: Mục đích của bạn là gì?"
    } ]
  }, {
    "tStartMs": 167257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nguyên nhân gì thúc đẩy bạn? Niềm tin của bạn là gì?"
    } ]
  }, {
    "tStartMs": 170257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Tại sao tổ chức của bạn là tồn tại?"
    } ]
  }, {
    "tStartMs": 173257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tại sao bạn lại thức dây khỏi giường vào buổi sáng?"
    } ]
  }, {
    "tStartMs": 175257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và tại sao mọi người lại phải quan tâm?"
    } ]
  }, {
    "tStartMs": 178257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Vâng, như là cái kết quả, cách mà chúng ta nghĩ, cách mà chúng ta hành động,"
    } ]
  }, {
    "tStartMs": 180257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Cách mà chúng ta giao tiếp là dạng từ bên ngoài vào."
    } ]
  }, {
    "tStartMs": 182257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nó rõ ràng. Chúng ta đi từ thứ rõ ràng nhất cho đến thứ mờ nhạt nhất."
    } ]
  }, {
    "tStartMs": 185257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nhưng những nhà lãnh đạo đầy cảm hứng"
    } ]
  }, {
    "tStartMs": 187257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và những tổ chức đầy cảm hứng,"
    } ]
  }, {
    "tStartMs": 189257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "bất kể ở quy mô và lĩnh vực nào,"
    } ]
  }, {
    "tStartMs": 192257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "tất cả đều nghĩ, hành động và giao tiếp"
    } ]
  }, {
    "tStartMs": 194257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "từ bên trong ra."
    } ]
  }, {
    "tStartMs": 197257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Để tôi cho bạn một ví dụ."
    } ]
  }, {
    "tStartMs": 199257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Tôi dùng Apple bởi vì nó dễ hiểu và mọi người hiểu nó."
    } ]
  }, {
    "tStartMs": 202257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nếu Apple giống như những người khác,"
    } ]
  }, {
    "tStartMs": 205257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "thông điệp marketing từ họ có lẽ nghe như thế này."
    } ]
  }, {
    "tStartMs": 208257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "\"Chúng tôi làm những máy tính tuyệt vời."
    } ]
  }, {
    "tStartMs": 211257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Chúng được thiết kế đẹp, sử dụng đơn giản"
    } ]
  }, {
    "tStartMs": 213257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và thân thiện với người dùng."
    } ]
  }, {
    "tStartMs": 215257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Muốn mua một cái chứ?\" Nei."
    } ]
  }, {
    "tStartMs": 218257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và đó là cách mà đa phần trong chúng ta giao tiếp."
    } ]
  }, {
    "tStartMs": 220257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Đó là cách mà đa phần marketing và những cuộc buôn bán đã được thực hiện."
    } ]
  }, {
    "tStartMs": 222257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và đó là cách mà hầu hết chúng ta giao tiếp một cách thân mật với nhau."
    } ]
  }, {
    "tStartMs": 224257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Chúng ta nói cái chúng ta làm, chúng ta nói cách chúng ta khác biệt như thế nào và tốt hơn như thế nào"
    } ]
  }, {
    "tStartMs": 227257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và chúng ta mong đợi những dạng như hành vi,"
    } ]
  }, {
    "tStartMs": 229257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mua hàng, bầu chọn, hay thứ gì đó như thế."
    } ]
  }, {
    "tStartMs": 231257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Đây là hãng luật mới của chúng tôi."
    } ]
  }, {
    "tStartMs": 233257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Chúng tôi có những luật sư tốt nhất với những khách hàng bự nhất."
    } ]
  }, {
    "tStartMs": 235257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Chúng tôi luôn làm việc vì khách hàng."
    } ]
  }, {
    "tStartMs": 237257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Đây là chiếc xe mới của chúng tôi."
    } ]
  }, {
    "tStartMs": 239257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nó có đồng hồ đo nhiên liệu tuyệt vời và ghế bọc da. Hãy mua xe của chúng tôi."
    } ]
  }, {
    "tStartMs": 242257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nhưng nó chẳng gây cảm hứng gì cả."
    } ]
  }, {
    "tStartMs": 244257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Đây là cách Apple thực sự giao tiếp."
    } ]
  }, {
    "tStartMs": 248257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "\"Mọi thứ chúng tôi làm,"
    } ]
  }, {
    "tStartMs": 250257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "chúng tôi tin tưởng vào việc thử thách tình trạng hiện tại."
    } ]
  }, {
    "tStartMs": 253257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Chúng tôi tin tưởng vào việc nghĩ một cách khác biệt."
    } ]
  }, {
    "tStartMs": 256257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Cách mà chúng tôi thử thách tình trạng hiện tại"
    } ]
  }, {
    "tStartMs": 258257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "là bằng cách làm những sản phẩm của mình được thiết kế tuyệt đẹp,"
    } ]
  }, {
    "tStartMs": 261257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "đơn giản sử dụng và thân thiệt với người dùng."
    } ]
  }, {
    "tStartMs": 263257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Chúng tôi tình cờ làm được những chiếc máy tính tuyệt vời."
    } ]
  }, {
    "tStartMs": 266257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Muốn mua 1 cái chứ?\""
    } ]
  }, {
    "tStartMs": 268257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Hoàn toàn khác biệt đúng không? Tôi sẵn sàng để mua một chiếc máy tính từ mình."
    } ]
  }, {
    "tStartMs": 271257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tất cả những gì tôi làm đảo ngược thứ tự của thông tin."
    } ]
  }, {
    "tStartMs": 273257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Cái mà nó chứng tỏ cho chúng ta làm người ta không những thứ bạn làm,"
    } ]
  }, {
    "tStartMs": 276257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "họ mua cái mà tại sao bạn làm nó."
    } ]
  }, {
    "tStartMs": 278257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Người ta không mua cái bạn làm, họ mua lý do mà bạn làm nó."
    } ]
  }, {
    "tStartMs": 280257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nó giải thích tại sao"
    } ]
  }, {
    "tStartMs": 282257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mỗi một con người trong căn phòng này"
    } ]
  }, {
    "tStartMs": 284257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "hoàn toàn thoải mái để mua máy tính từ Apple."
    } ]
  }, {
    "tStartMs": 287257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nhưng chúng ta cũng hoàn toàn thoải mái"
    } ]
  }, {
    "tStartMs": 289257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "mua những chiếc máy MP3 từ Apple, hay điện thoại từ Apple,"
    } ]
  }, {
    "tStartMs": 292257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "hay DVR từ Apple."
    } ]
  }, {
    "tStartMs": 294257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nhưng, như tôi nói từ trước, Apple chỉ là một công ty máy tính."
    } ]
  }, {
    "tStartMs": 296257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ở đây không có gì phân biệt họ"
    } ]
  }, {
    "tStartMs": 298257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "về mặt cấu trúc với bất cứ các đối thủ nào."
    } ]
  }, {
    "tStartMs": 300257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Những đối thủ của họ đều cân xứng về khả năng để làm tất cả những sản phẩm này."
    } ]
  }, {
    "tStartMs": 303257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "thực tế, họ đã thử."
    } ]
  }, {
    "tStartMs": 305257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Vài năm trước đây, Gateway giới thiệu TV màn hình phẳng."
    } ]
  }, {
    "tStartMs": 308257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Họ đủ khả năng để làm những TV màn hình phẳng."
    } ]
  }, {
    "tStartMs": 310257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Họ đã làm màn hình máy tính phẳng hàng năm trời."
    } ]
  }, {
    "tStartMs": 313257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Không ai mua cả."
    } ]
  }, {
    "tStartMs": 320257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Dell giới thiệt máy nghe nhạc MP3 và PDA"
    } ]
  }, {
    "tStartMs": 323257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và họ làm những sản phẩm chất lượng tuyệt vời."
    } ]
  }, {
    "tStartMs": 325257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và họ có thể làm những sản phẩm thiết kế tuyệt vời."
    } ]
  }, {
    "tStartMs": 328257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và không ai mua cả."
    } ]
  }, {
    "tStartMs": 330257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Thực tế, nói về nó bây giờ, chúng ta thậm chí không thể tưởng tượng"
    } ]
  }, {
    "tStartMs": 332257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mua một máy MP3 từ Dell."
    } ]
  }, {
    "tStartMs": 334257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tại sao bạn lại mua máy MP3 từ một công ty máy tính?"
    } ]
  }, {
    "tStartMs": 336257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nhưng chúng ta làm thế mỗi ngày."
    } ]
  }, {
    "tStartMs": 338257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Người ta không mua cái bạn làm, họ mua lý do mà bạn làm nó."
    } ]
  }, {
    "tStartMs": 340257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Mục tiêu không phải là làm kinh doanh"
    } ]
  }, {
    "tStartMs": 342257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "với mọi người cần cái mà bạn có."
    } ]
  }, {
    "tStartMs": 346257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Mục tiêu là làm kinh doanh với những ai"
    } ]
  }, {
    "tStartMs": 348257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "tin vào cái mà bạn tin tưởng."
    } ]
  }, {
    "tStartMs": 351257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Đây là phần hay nhất."
    } ]
  }, {
    "tStartMs": 353257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Không có gì tôi nói là ý kiến của tôi."
    } ]
  }, {
    "tStartMs": 355257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Tất cả đều dựa trên những căn cứ sinh học."
    } ]
  }, {
    "tStartMs": 358257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Không phải tâm lý học, sinh học."
    } ]
  }, {
    "tStartMs": 360257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nếu bạn nhìn vào mặt cắt ngang của não người, từ trên xuống,"
    } ]
  }, {
    "tStartMs": 363257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Cái mà bạn thấy là não người thật sự chia ra"
    } ]
  }, {
    "tStartMs": 365257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "thành ba bộ phận chính"
    } ]
  }, {
    "tStartMs": 367257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "mà tương quan hoàn hảo với vòng tròn vàng."
    } ]
  }, {
    "tStartMs": 370257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Phần não sớm nhất của chúng ta, não homo sapien"
    } ]
  }, {
    "tStartMs": 373257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "não neocortex"
    } ]
  }, {
    "tStartMs": 375257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "tương quan với mức độ \"Cái gì\""
    } ]
  }, {
    "tStartMs": 377257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Phần não neocortex mới chịu trách nhiệm cho tất cả"
    } ]
  }, {
    "tStartMs": 379257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "những suy nghĩ phân tích và lý trí"
    } ]
  }, {
    "tStartMs": 381257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và ngôn ngữ."
    } ]
  }, {
    "tStartMs": 383257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Phần thứ hai ở giữa được tạo bởi não limbic"
    } ]
  }, {
    "tStartMs": 386257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và não limbic của chúng ta chịu trách nhiệm về tất cả những cảm xúc của chúng ta,"
    } ]
  }, {
    "tStartMs": 389257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "giống như sự tin tưởng và lòng trung thành."
    } ]
  }, {
    "tStartMs": 392257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nó cũng chịu trách nhiệm cho tất cả hành vi của con người,"
    } ]
  }, {
    "tStartMs": 394257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "tất cả những quyết định,"
    } ]
  }, {
    "tStartMs": 396257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "và nó không có chỗ cho ngôn ngữ."
    } ]
  }, {
    "tStartMs": 399257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nói một cách khác, khi chúng ta giao tiếp từ ngoài vào,"
    } ]
  }, {
    "tStartMs": 402257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "vâng, con người có thể hiểu một lượng lớn những thông tin phức tạp"
    } ]
  }, {
    "tStartMs": 405257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "như điểm đặc trưng và lợi ích và sự kiện và con số"
    } ]
  }, {
    "tStartMs": 408257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nó chỉ không điều khiển hành vi."
    } ]
  }, {
    "tStartMs": 410257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Khi chúng ta có thể giao tiếp từ trong ra ngoài,"
    } ]
  }, {
    "tStartMs": 412257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "chúng ta nói chuyện trực tiếp với phần của nảo"
    } ]
  }, {
    "tStartMs": 414257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mà điều khiển hành vi,"
    } ]
  }, {
    "tStartMs": 416257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và kế đến chúng ta cho phép người ta hợp lý hóa nó"
    } ]
  }, {
    "tStartMs": 418257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "với những thứ hữu hình mà chúng ta nói và làm."
    } ]
  }, {
    "tStartMs": 420257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Đó là nơi khởi nguồn cho những quyết định sáng suốt."
    } ]
  }, {
    "tStartMs": 422257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Bạn biết đó, đôi khi bạn có thể đưa cho ai đó"
    } ]
  }, {
    "tStartMs": 424257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "tất cả các sự kiện và con số,"
    } ]
  }, {
    "tStartMs": 426257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và họ nói, \"Tôi biết tất cả những sự kiện và chi tiết nói về cái gì,"
    } ]
  }, {
    "tStartMs": 428257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "nhưng chỉ không cảm thấy đúng.\""
    } ]
  }, {
    "tStartMs": 430257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Tại sao chúng ta sử dụng động từ, \"không cảm thấy\" đúng?"
    } ]
  }, {
    "tStartMs": 433257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Bởi vì phần của não mà điều khiển sự quyết định,"
    } ]
  }, {
    "tStartMs": 435257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "không điều khiển ngôn ngữ."
    } ]
  }, {
    "tStartMs": 437257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và điều tốt nhất mà chúng ta có thể tập hợp lại được là, \"Tôi không biết, nó chỉ không cảm thấy đúng.\""
    } ]
  }, {
    "tStartMs": 440257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Hay đôi khi bạn nói bạn đang lãnh đạo bằng trái tim mình,"
    } ]
  }, {
    "tStartMs": 442257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "hay bạn đang lãnh đạo bằng bằng tâm hồn."
    } ]
  }, {
    "tStartMs": 444257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Chà, tôi ghét phải giải thích nó cho bạn, những thứ đó không phải những bộ phận khác trên cơ thể bạn"
    } ]
  }, {
    "tStartMs": 446257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "điều khiển hành vi của bạn."
    } ]
  }, {
    "tStartMs": 448257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tất cả nó đang diễn ra ở đây trong não limbic của bạn,"
    } ]
  }, {
    "tStartMs": 450257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "phần của não mà điều khiển sự đưa ra quyết định và không phải là ngôn ngữ."
    } ]
  }, {
    "tStartMs": 453257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nhưng nếu bạn không biết tại sao bạn làm cái mà bạn làm,"
    } ]
  }, {
    "tStartMs": 456257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "và người ta trả lời cho tại sao bạn làm thứ mà bạn làm,"
    } ]
  }, {
    "tStartMs": 459257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "kế tiếp làm thế nào mà bạn có thể có ai đó"
    } ]
  }, {
    "tStartMs": 462257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "để mà bầu cho bạn, hay mua gì đó từ bạn,"
    } ]
  }, {
    "tStartMs": 464257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "hay, quan trong hơn, là trung thành với bạn"
    } ]
  }, {
    "tStartMs": 466257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "và muốn là một phần của cái mà bạn làm."
    } ]
  }, {
    "tStartMs": 469257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Lần nữa, mục tiêu không chỉ là bán cho những người mà họ cần cái mà bạn có;"
    } ]
  }, {
    "tStartMs": 472257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "mục tiêu là bán cho những người mà họ tin vào cái mà bạn tin."
    } ]
  }, {
    "tStartMs": 475257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Mục tiêu không chỉ là thuê người ta"
    } ]
  }, {
    "tStartMs": 477257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "người mà cần công việc;"
    } ]
  }, {
    "tStartMs": 479257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "nó là thuê người mà họ tin vào cái mà bạn tin."
    } ]
  }, {
    "tStartMs": 482257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Tôi luôn nói thế, bạn biết đấy,"
    } ]
  }, {
    "tStartMs": 487257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "nếu như bạn thuê người chỉ vì họ có thể làm việc, họ sẽ làm vì tiền của bạn,"
    } ]
  }, {
    "tStartMs": 490257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "nhưng nếu bạn thuê người mà họ tin vào cái mà bạn tin,"
    } ]
  }, {
    "tStartMs": 492257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "họ sẽ làm cho bạn với máu, mồ hôi và nước mắt."
    } ]
  }, {
    "tStartMs": 494257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và không ở đâu khác ngoài ở đây có ví dụ tốt hơn"
    } ]
  }, {
    "tStartMs": 496257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "với anh em nhà Wright."
    } ]
  }, {
    "tStartMs": 498257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Hầu hết mọi người không biết về Samuel Pierpont Langley."
    } ]
  }, {
    "tStartMs": 501257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và quay lại đầu thế kỷ 20,"
    } ]
  }, {
    "tStartMs": 504257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "theo đuổi các chuyến bay điều khiển bằng con người giống như thời kỳ bùng nổ công nghệ thông tin ngày nay."
    } ]
  }, {
    "tStartMs": 507257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Mọi người đang thử nó."
    } ]
  }, {
    "tStartMs": 509257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và Samuel Pierpont Langley có, cái mà chúng ta giả định,"
    } ]
  }, {
    "tStartMs": 512257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "công thức cho sự thành công."
    } ]
  }, {
    "tStartMs": 515257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ý tôi là, thậm chí bây giờ, bạn hỏi người ta,"
    } ]
  }, {
    "tStartMs": 517257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "\"Tại sao sản phẩm của bạn hay tại sao công ty bạn lại thất bại?\""
    } ]
  }, {
    "tStartMs": 519257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và người ta sẽ luôn cho bạn cùng hoán vị"
    } ]
  }, {
    "tStartMs": 521257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "của cùng 3 thứ sau:"
    } ]
  }, {
    "tStartMs": 523257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "nguồn đầu tư không đủ, nhân sự yếu kém, điều kiện thị trường xấu."
    } ]
  }, {
    "tStartMs": 526257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nó luôn luôn là vì 3 điều đó, vậy hãy cùng xem xét nó."
    } ]
  }, {
    "tStartMs": 529257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Samuel Pierpont Langley"
    } ]
  }, {
    "tStartMs": 531257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "được chi 50,000 đô la bởi Sở Tham Chiến"
    } ]
  }, {
    "tStartMs": 534257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "để chế tạo ra chiếc máy bay."
    } ]
  }, {
    "tStartMs": 536257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tiền đã không là vấn đề."
    } ]
  }, {
    "tStartMs": 538257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ông ta có chiếc ghế tại Harvard"
    } ]
  }, {
    "tStartMs": 540257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "và đã làm việc tại Smithsonian và có những mối quan hệ cực kỳ tốt."
    } ]
  }, {
    "tStartMs": 543257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ông ta biết tất cả những người tài thời đấy."
    } ]
  }, {
    "tStartMs": 545257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ông ta thuê những người giỏi nhất"
    } ]
  }, {
    "tStartMs": 547257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "tiền có thể tìm được."
    } ]
  }, {
    "tStartMs": 549257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và điều kiện thị trường rất ư là tuyệt vời."
    } ]
  }, {
    "tStartMs": 551257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Báo New York Times theo ông ta mọi nơi."
    } ]
  }, {
    "tStartMs": 554257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và mọi người chầu chật đợi Langley."
    } ]
  }, {
    "tStartMs": 556257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Vậy làm thế nào mà bạn chưa từng nghe về Samuel pierpont Langley?"
    } ]
  }, {
    "tStartMs": 559257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và vài trăm dặm cách đó tại Dayton Ohio,"
    } ]
  }, {
    "tStartMs": 562257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Orville và Wibur Wright"
    } ]
  }, {
    "tStartMs": 564257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Họ không có bất cứ cái gì mà chúng ta cho là"
    } ]
  }, {
    "tStartMs": 566257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "công thức của sự thành công"
    } ]
  }, {
    "tStartMs": 568257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Họ không có tiền."
    } ]
  }, {
    "tStartMs": 570257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Họ trả cho giấc mơ của mình bằng số tiền thu được từ cửa hàng xe đạp."
    } ]
  }, {
    "tStartMs": 573257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Không bất cứ ai trong đội của anh em nhà Wright"
    } ]
  }, {
    "tStartMs": 575257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "có bằng đại học,"
    } ]
  }, {
    "tStartMs": 577257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "thậm chí cả Orville và Willbur."
    } ]
  }, {
    "tStartMs": 579257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và báo New York Times không theo họ bất cứ đâu."
    } ]
  }, {
    "tStartMs": 582257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Sự khác biết là,"
    } ]
  }, {
    "tStartMs": 584257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Orville và Wilbur được thúc đẩy bởi một nguyên nhân,"
    } ]
  }, {
    "tStartMs": 586257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "bởi một mục đích và bởi một niềm tin."
    } ]
  }, {
    "tStartMs": 588257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Họ tin rằng nếu họ"
    } ]
  }, {
    "tStartMs": 590257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "có thể nghĩ ra được cỗ máy bay,"
    } ]
  }, {
    "tStartMs": 592257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "nó có thế thay đổi diễn biến của thế giới."
    } ]
  }, {
    "tStartMs": 595257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Samuel Pierpont Langley thì khác."
    } ]
  }, {
    "tStartMs": 597257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Ông ta muốn giàu, và ông ta muốn được nổi tiếng."
    } ]
  }, {
    "tStartMs": 600257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ông ta đã theo đuổi kết quả."
    } ]
  }, {
    "tStartMs": 602257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ông đã theo đuổi sự giàu có."
    } ]
  }, {
    "tStartMs": 604257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và xem chuyện gì đã xảy ra."
    } ]
  }, {
    "tStartMs": 607257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Người mà họ tin vào giấc mơ anh em nhà Wright,"
    } ]
  }, {
    "tStartMs": 609257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "làm việc với họ bằng máu, mồ hôi, và nước mắt."
    } ]
  }, {
    "tStartMs": 612257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Những người khác chỉ làm việc cho tiền lương."
    } ]
  }, {
    "tStartMs": 614257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và họ kể những câu chuyện về mỗi lần mà anh em nhà Wright đi ra,"
    } ]
  }, {
    "tStartMs": 617257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "họ sẽ phải lấy 5 bộ cấu kiện,"
    } ]
  }, {
    "tStartMs": 619257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "bởi vì đó là số lần mà họ thất bại"
    } ]
  }, {
    "tStartMs": 621257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "trước khi họ trở thành siêu anh hùng."
    } ]
  }, {
    "tStartMs": 624257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và, tình cờ, vào ngày 17 tháng 12, 1903,"
    } ]
  }, {
    "tStartMs": 627257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Anh em nhà Wright đã bay,"
    } ]
  }, {
    "tStartMs": 630257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và không ai ở đó thậm chí trải nghiệm nó."
    } ]
  }, {
    "tStartMs": 632257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Chúng ta biết về nó vài ngày sau."
    } ]
  }, {
    "tStartMs": 636257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và những bằng chứng cho thấy Langley"
    } ]
  }, {
    "tStartMs": 638257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "đã được thúc đẩy bởi những điều sai,"
    } ]
  }, {
    "tStartMs": 640257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "cái ngày mà anh em nhà Wright bay lên, ông ta bỏ cuộc."
    } ]
  }, {
    "tStartMs": 643257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ông ta có thể đã nói,"
    } ]
  }, {
    "tStartMs": 645257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "\"Đó là một khám phá tuyệt vời, các anh,"
    } ]
  }, {
    "tStartMs": 647257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "và tôi sẽ cải thiện hơn công nghệ của các anh,\" nhưng ông ta đã không"
    } ]
  }, {
    "tStartMs": 650257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ông ta không là người đầu tiên phát minh ra, cho nên ông cũng không giàu lên,"
    } ]
  }, {
    "tStartMs": 652257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "cũng không nổi tiếng thêm, vì thế ông ta bỏ cuộc."
    } ]
  }, {
    "tStartMs": 654257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Người ta không mua cái bạn làm, họ mua lý do mà bạn làm nó."
    } ]
  }, {
    "tStartMs": 657257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và nếu tôi nói về cái mà tin tưởng"
    } ]
  }, {
    "tStartMs": 659257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "bạn sẽ thu hút những ai tin cái mà bạn tin."
    } ]
  }, {
    "tStartMs": 662257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nhưng tại sao nó lại quan trọng thu hút những ai tin cái mà bạn tin?"
    } ]
  }, {
    "tStartMs": 667257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Mọi thứ gọi là quy luật phổ biến của sự cải tiến."
    } ]
  }, {
    "tStartMs": 669257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và nếu như bạn không biết về luật, bạn chắc chắn phải biết thuật ngữ này."
    } ]
  }, {
    "tStartMs": 672257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "2.5% đầu tiên của dân số thế giới"
    } ]
  }, {
    "tStartMs": 675257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "là những người tiên phong đi tìm cái mới."
    } ]
  }, {
    "tStartMs": 677257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "13.5% kế tiếp của dân số thế giới"
    } ]
  }, {
    "tStartMs": 680257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "là những người sớm chấp nhận."
    } ]
  }, {
    "tStartMs": 682257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và 34% kế tiếp phần đa số."
    } ]
  }, {
    "tStartMs": 684257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Đa phần những người đến sau và những người cuối cùng."
    } ]
  }, {
    "tStartMs": 687257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Cái lý do duy nhất những người này mua điện thoại cảm ứng"
    } ]
  }, {
    "tStartMs": 690257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "là bởi vì họ không thể mua điện thoại quay số được nữa."
    } ]
  }, {
    "tStartMs": 692257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "(Cười)"
    } ]
  }, {
    "tStartMs": 694257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Chúng ta đều đứng ở những nơi khác nhau vào những thời điểm khác nhau trong tỷ lệ này,"
    } ]
  }, {
    "tStartMs": 697257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "nhưng cái mà quy luật phổ biển của sự cái tiến này muốn nói với chúng ta"
    } ]
  }, {
    "tStartMs": 700257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "là nếu như bạn muốn thành công trên thị trường đại trà"
    } ]
  }, {
    "tStartMs": 703257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "hay sự chấp nhận của thị trường đại trà về cái ý tưởng,"
    } ]
  }, {
    "tStartMs": 705257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Bạn không thể có nó"
    } ]
  }, {
    "tStartMs": 707257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "cho đến khi bạn đạt được đến điểm nút này"
    } ]
  }, {
    "tStartMs": 709257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "khoảng 15 đến 18 phần trăm thị phần."
    } ]
  }, {
    "tStartMs": 712257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và kế đến là các đỉnh hệ thống."
    } ]
  }, {
    "tStartMs": 715257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và tôi thích hỏi về công việc kinh doanh, \" Tỉ lệ hối đoái của bạn trong lần kinh doanh mới là bao nhiêu?\""
    } ]
  }, {
    "tStartMs": 718257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và họ thích trả lời bạn một cách hãnh diện, \"Oh, nó khoảng 10 phần trăm\""
    } ]
  }, {
    "tStartMs": 720257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Chà, Bạn có thể nắm 10 phần trăm khách hàng."
    } ]
  }, {
    "tStartMs": 722257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tất cả mà bạn có chỉ là 10 phần trăm của những ai chỉ \"hiểu nó.\""
    } ]
  }, {
    "tStartMs": 724257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Đó là cách mà chúng ta mô tả họ, đúng chứ."
    } ]
  }, {
    "tStartMs": 726257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nó giống như là cảm giác trong bụng, \"Chà, họ chỉ mới hiểu nó.\""
    } ]
  }, {
    "tStartMs": 728257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Vấn đề là: Làm cách nào bạn tìm được người hiểu nó"
    } ]
  }, {
    "tStartMs": 731257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "trước khi bạn làm kinh doanh với họ so với những người không hiểu được nó?"
    } ]
  }, {
    "tStartMs": 734257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Vậy nó ở đây, cái khoảng cách nhỏ này,"
    } ]
  }, {
    "tStartMs": 736257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mà bạn phải tiến gần lại,"
    } ]
  }, {
    "tStartMs": 738257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "như Jeffrey Moore gọi nó là \"vược qua vực thẳm.\""
    } ]
  }, {
    "tStartMs": 740257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Bạn thấy đấy, bởi vì đa phần đầu tiên"
    } ]
  }, {
    "tStartMs": 742257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "sẽ không thử thứ gì đó"
    } ]
  }, {
    "tStartMs": 744257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "cho đến khi có ai đó"
    } ]
  }, {
    "tStartMs": 746257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "đã thử nó trước."
    } ]
  }, {
    "tStartMs": 748257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và những gã này, những người tiên phong và những người chấp nhận sớm,"
    } ]
  }, {
    "tStartMs": 751257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "họ cảm thấy thoải mái làm những quyết định quyết tâm đó."
    } ]
  }, {
    "tStartMs": 753257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Họ thoải mái hơn khi đưa ra những quyết định trực quan"
    } ]
  }, {
    "tStartMs": 756257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "được dẫn dắt bởi cái mà họ tin về thế giới"
    } ]
  }, {
    "tStartMs": 760257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và không chỉ là giá trị sản phẩm."
    } ]
  }, {
    "tStartMs": 762257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Đó là những người xếp hàng khoảng sáu tiếng đồng hồ"
    } ]
  }, {
    "tStartMs": 764257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "để mua iPhone khi chúng vừa ra mắt,"
    } ]
  }, {
    "tStartMs": 766257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "khi bạn có thể đi đến cửa hàng tuần sau"
    } ]
  }, {
    "tStartMs": 768257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và mua một cái trên kệ."
    } ]
  }, {
    "tStartMs": 770257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Có những người chi 40,000 đô la"
    } ]
  }, {
    "tStartMs": 772257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "cho TV màn hình phẳng khi chúng vừa được giới thiệu,"
    } ]
  }, {
    "tStartMs": 775257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "thậm chí công nghệ dưới mức tiêu chuẩn."
    } ]
  }, {
    "tStartMs": 778257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và, tiện thể, họ không làm điều đó"
    } ]
  }, {
    "tStartMs": 780257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "bởi vì công nghệ quá tuyệt vời."
    } ]
  }, {
    "tStartMs": 782257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Họ làm cho chính bản thân họ."
    } ]
  }, {
    "tStartMs": 784257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nó bởi vì họ muốn là đầu tiên."
    } ]
  }, {
    "tStartMs": 786257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Người ta không mua cái mà bạn làm, họ mua tại sao bạn làm nó."
    } ]
  }, {
    "tStartMs": 788257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và cái bạn làm đơn giản"
    } ]
  }, {
    "tStartMs": 790257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "chúng minh cái mà bạn tin."
    } ]
  }, {
    "tStartMs": 792257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Thực tế, người ta sẽ làm những thứ"
    } ]
  }, {
    "tStartMs": 794257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mà chúng minh được cái mà họ tin."
    } ]
  }, {
    "tStartMs": 796257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Lý do mà người ta mua iPhone"
    } ]
  }, {
    "tStartMs": 798257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "trong 6 giờ đầu tiên,"
    } ]
  }, {
    "tStartMs": 801257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "xếp hàng trong 6 tiếng đồng hồ,"
    } ]
  }, {
    "tStartMs": 803257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "là bởi vì họ tin về thế giới,"
    } ]
  }, {
    "tStartMs": 805257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và cái cách họ muốn mọi người nhìn họ."
    } ]
  }, {
    "tStartMs": 807257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Họ là đầu tiên."
    } ]
  }, {
    "tStartMs": 809257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Người ta không mua cái bạn làm, họ mua lý do mà bạn làm nó."
    } ]
  }, {
    "tStartMs": 811257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Vậy để tôi đưa cho bạn một ví dụ nổi tiếng,"
    } ]
  }, {
    "tStartMs": 813257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "một thất bạn nổi tiếng và một thành công nổi tiếng"
    } ]
  }, {
    "tStartMs": 815257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "của cái quy luật phổ biến của sự cải tiến."
    } ]
  }, {
    "tStartMs": 817257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Đầu tiên là thất bại nổi tiếng."
    } ]
  }, {
    "tStartMs": 819257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nó là ví dụ mang tính thương mại."
    } ]
  }, {
    "tStartMs": 821257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Như mà chúng ta nói vài giây trước đây,"
    } ]
  }, {
    "tStartMs": 823257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Công thức cho sự thành công là tiền và đúng người mua và đúng điều kiện thị trường."
    } ]
  }, {
    "tStartMs": 826257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Đúng, bạn sẽ có thành công đó."
    } ]
  }, {
    "tStartMs": 828257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nhìn vào TiVO"
    } ]
  }, {
    "tStartMs": 830257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Từ thời điểm TiVo ra đời, vào khoảng 8 hay 9 năm trước,"
    } ]
  }, {
    "tStartMs": 832257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "cho đến ngày hôm nay,"
    } ]
  }, {
    "tStartMs": 834257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Họ là sản phẩm chất lượng tốt nhất và duy nhất trên thị trường,"
    } ]
  }, {
    "tStartMs": 837257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "bỏ tay xuống, không có tranh cãi nhé."
    } ]
  }, {
    "tStartMs": 840257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Họ được tài trợ vô cùng tốt."
    } ]
  }, {
    "tStartMs": 842257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Điều kiện thị trường rất ư hoàn hảo."
    } ]
  }, {
    "tStartMs": 844257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ý tôi là, chúng ta dùng TiVo như là động từ"
    } ]
  }, {
    "tStartMs": 846257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Tôi TiVo những thứ tạp nham của mình trên cái máy chiếu phim Time Warmer liên tục."
    } ]
  }, {
    "tStartMs": 852257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nhưng TiVo là một thất bại thương mại."
    } ]
  }, {
    "tStartMs": 854257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Họ chưa từng làm ra tiền."
    } ]
  }, {
    "tStartMs": 856257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và khi họ đến với IPO"
    } ]
  }, {
    "tStartMs": 858257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "cổ phiếu có họ vào khoảng 30 hay 40 đô la"
    } ]
  }, {
    "tStartMs": 860257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và sau đó xuống dốc và nó chưa từng được giao dịch trên 10."
    } ]
  }, {
    "tStartMs": 862257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Thực tế, tôi chưa từng thấy nó được giao dịch trên 6,"
    } ]
  }, {
    "tStartMs": 865257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "trừ đôi lần tăng đột ngột nhẹ."
    } ]
  }, {
    "tStartMs": 867257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Bởi vì như bạn thấy đó, khi TiVo giới thiệu sản phẩm của họ,"
    } ]
  }, {
    "tStartMs": 869257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "họ nói cho chúng ta tất cả những cái mà họ có."
    } ]
  }, {
    "tStartMs": 872257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Họ bảo, chúng tôi có sản phẩm mà có thể dừng chương trình trực tiếp,"
    } ]
  }, {
    "tStartMs": 875257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "tua qua quảng cáo, tua lại chương trình trực tiếp"
    } ]
  }, {
    "tStartMs": 878257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và nhớ những thói quen xem của bạn"
    } ]
  }, {
    "tStartMs": 880257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "thậm chí bạn chưa từng hỏi.\""
    } ]
  }, {
    "tStartMs": 883257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và phần lớn hoài nghi nói,"
    } ]
  }, {
    "tStartMs": 885257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "\"Chúng tôi không tin anh."
    } ]
  }, {
    "tStartMs": 887257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Chúng tôi không cần nó. Chúng tôi không thích nó."
    } ]
  }, {
    "tStartMs": 889257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Anh đang dọa chúng tôi.\""
    } ]
  }, {
    "tStartMs": 891257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nếu như nếu họ nói,"
    } ]
  }, {
    "tStartMs": 893257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "\"Nếu như bạn là người mà"
    } ]
  }, {
    "tStartMs": 895257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "thích có được toàn quyền điều khiển"
    } ]
  }, {
    "tStartMs": 898257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "mọi khía cạnh của cuộc sống của mình,"
    } ]
  }, {
    "tStartMs": 901257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "cậu bé, chúng tôi có 1 sản phẩm dành cho bạn."
    } ]
  }, {
    "tStartMs": 904257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nó dừng chương trình trực tiếp, bỏ qua đoạn quảng cáo,"
    } ]
  }, {
    "tStartMs": 906257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "nhớ những thói quen xem phim của bạn, vân vân.\""
    } ]
  }, {
    "tStartMs": 909257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Người ta không mua cái bạn làm, họ mua lý do mà bạn làm nó."
    } ]
  }, {
    "tStartMs": 911257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và cái mà bạn phục vụ họ đơn giản chỉ như là"
    } ]
  }, {
    "tStartMs": 913257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "bằng chứng cho cái mà bạn tin tưởng."
    } ]
  }, {
    "tStartMs": 915257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Bây giờ để tôi đưa cho bạn một ví dụ thành công"
    } ]
  }, {
    "tStartMs": 918257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "của quy luật phổ biển của sự cải tiến."
    } ]
  }, {
    "tStartMs": 921257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Vào mùa vè năm 1963,"
    } ]
  }, {
    "tStartMs": 924257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "250,000 người xuất hiện"
    } ]
  }, {
    "tStartMs": 926257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "trên trung tâm mua sắm tại Washington"
    } ]
  }, {
    "tStartMs": 928257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "để nghe Tiến sĩ King nói."
    } ]
  }, {
    "tStartMs": 931257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Không không gửi bất cứ lời mời nào,"
    } ]
  }, {
    "tStartMs": 934257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "và ở đây cũng không có website để coi ngày diễn ra."
    } ]
  }, {
    "tStartMs": 937257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Bạn làm như thế nào?"
    } ]
  }, {
    "tStartMs": 939257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Chà, Tiến sĩ King không phải là người duy nhất tại Mỹ"
    } ]
  }, {
    "tStartMs": 941257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mà là một nhà hùng biện vĩ đại."
    } ]
  }, {
    "tStartMs": 943257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ông cũng không phải là người duy nhất tại Mỹ chịu đựng"
    } ]
  }, {
    "tStartMs": 945257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "trong thời kỳ trước đây của quyền công nhân Mỹ."
    } ]
  }, {
    "tStartMs": 947257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Thực tế, một vài ý tưởng của ông ta là tệ."
    } ]
  }, {
    "tStartMs": 950257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nhưng ông ta có biệt tại."
    } ]
  }, {
    "tStartMs": 952257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Ông ta không đi vòng quay và nói mọi người về cái cần được thay đổi ở Mỹ."
    } ]
  }, {
    "tStartMs": 955257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ông ta đi vòng quay và nói mọi người cái mà ông tin tưởng."
    } ]
  }, {
    "tStartMs": 957257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "\"Tôi tin. Tôi tin. Tôi tin,\""
    } ]
  }, {
    "tStartMs": 959257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Ông nói với mọi người."
    } ]
  }, {
    "tStartMs": 961257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và những ai mà tin vào cái mà ông tin tưởng"
    } ]
  }, {
    "tStartMs": 963257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "lấy động cơ đó của ông và họ làm nó thành của chính họ,"
    } ]
  }, {
    "tStartMs": 965257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và họ nói với người khác."
    } ]
  }, {
    "tStartMs": 967257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và một vài trong những người này đã tạo ra những cấu trúc"
    } ]
  }, {
    "tStartMs": 969257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "để thậm chỉ có thêm nhiều người hơn nữa."
    } ]
  }, {
    "tStartMs": 971257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Chậm và chú ý,"
    } ]
  }, {
    "tStartMs": 973257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "250,00 người xuất hiện"
    } ]
  }, {
    "tStartMs": 975257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "vào đúng ngày, vào đúng thời điểm"
    } ]
  }, {
    "tStartMs": 978257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "để nghe ông ta nói."
    } ]
  }, {
    "tStartMs": 980257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Bao nhiêu người xuất hiện cho ông ấy?"
    } ]
  }, {
    "tStartMs": 984257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Số không."
    } ]
  }, {
    "tStartMs": 986257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Họ xuất hiện cho bản thân họ."
    } ]
  }, {
    "tStartMs": 988257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Đó là cái mà họ tin về nước Mỹ"
    } ]
  }, {
    "tStartMs": 990257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "mà đã làm cho họ đón xe buýt đi gần 8 tiếng,"
    } ]
  }, {
    "tStartMs": 993257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "và đứng dưới ánh mặt trời tại Washington vào giữa tháng 8."
    } ]
  }, {
    "tStartMs": 996257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nó là cái mà họ tin, và nó không phải là về trắng với đen."
    } ]
  }, {
    "tStartMs": 999257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "25% những người xem là da trắng."
    } ]
  }, {
    "tStartMs": 1002257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Tiến sĩ King tin rằng"
    } ]
  }, {
    "tStartMs": 1004257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "ở đây có hai dạng luật trên thế giới này,"
    } ]
  }, {
    "tStartMs": 1006257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "những điều mà làm bởi những thẩm quyền cao hơn"
    } ]
  }, {
    "tStartMs": 1008257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và những điều luật mà làm bởi con người."
    } ]
  }, {
    "tStartMs": 1010257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và không phải cho đến khi mà tất cả các luật mà làm bởi con người"
    } ]
  }, {
    "tStartMs": 1013257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "phù hợp vói những luật mà làm bởi những thẩm quyền cao hơn,"
    } ]
  }, {
    "tStartMs": 1015257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "chúng ta sẽ sống trong chỉ một thế giới."
    } ]
  }, {
    "tStartMs": 1017257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nó chỉ diễn ra như vậy mà Phong Trào Quyền Công Dân"
    } ]
  }, {
    "tStartMs": 1019257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "đã là điều tuyệt vời mà giúp ông ta"
    } ]
  }, {
    "tStartMs": 1022257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mang lý do của ông đến cuộc sống."
    } ]
  }, {
    "tStartMs": 1024257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Chúng ta theo sau, không phải cho ông ấy, mà cho chính chúng ta"
    } ]
  }, {
    "tStartMs": 1027257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Và, tiện thể, ông ta đã có bài diễn văn \"Tôi có một giấc mơ\","
    } ]
  }, {
    "tStartMs": 1029257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "chứ không phải bài diễn văn \"Tôi có một kế hoạch\"."
    } ]
  }, {
    "tStartMs": 1031257,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "(Cười)"
    } ]
  }, {
    "tStartMs": 1035257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nghe những nhà chính trị gia bây giờ với kế hoạch toàn diện 12 điểm của họ."
    } ]
  }, {
    "tStartMs": 1038257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Họ không truyền cảm hứng cho bất cứ ai."
    } ]
  }, {
    "tStartMs": 1040257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Bởi vì đây là nhà lãnh đạo và đây là những ai dẫn đầu."
    } ]
  }, {
    "tStartMs": 1043257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Những nhà lãnh đạo giữ vị trí cho sức mạnh"
    } ]
  }, {
    "tStartMs": 1045257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "và quyền lực."
    } ]
  }, {
    "tStartMs": 1047257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nhưng những ai mà dẫn đầu truyền cảm hứng cho chúng ta"
    } ]
  }, {
    "tStartMs": 1051257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Cho dù họ là cá nhân hay tổ chức,"
    } ]
  }, {
    "tStartMs": 1053257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Chúng ta theo những ai mà dẫn đầu,"
    } ]
  }, {
    "tStartMs": 1055257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "không phải vì chúng ta phải thế,"
    } ]
  }, {
    "tStartMs": 1057257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "mà bởi vì chúng ta muốn thế."
    } ]
  }, {
    "tStartMs": 1060257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Chúng ta theo những ai dẫn đầu, không phải cho họ,"
    } ]
  }, {
    "tStartMs": 1063257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mà cho chính chúng ta."
    } ]
  }, {
    "tStartMs": 1065257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Và đó là những ai mà bắt đầu với \"Tại sao\""
    } ]
  }, {
    "tStartMs": 1068257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "mà có khả năng"
    } ]
  }, {
    "tStartMs": 1070257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "để truyền cảm hứng cho những người xung quanh họ"
    } ]
  }, {
    "tStartMs": 1072257,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "hay tìm những người tuyền cảm hứng cho họ."
    } ]
  }, {
    "tStartMs": 1075257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Cảm ơn các bạn rất nhiều."
    } ]
  }, {
    "tStartMs": 1077257,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "(Vỗ tay)"
    } ]
  } ]
}
