{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 2759,
    "dDurationMs": 3809,
    "segs": [ {
      "utf8": "In many ways, \nthe work of a critic is easy."
    } ]
  }, {
    "tStartMs": 7163,
    "dDurationMs": 4269,
    "segs": [ {
      "utf8": "We risk very little, \nyet enjoy a position over those"
    } ]
  }, {
    "tStartMs": 11432,
    "dDurationMs": 3847,
    "segs": [ {
      "utf8": "who offer up their work \nand their selves to our judgment."
    } ]
  }, {
    "tStartMs": 15752,
    "dDurationMs": 5964,
    "segs": [ {
      "utf8": "We thrive on negative criticism, \nwhich is fun to write and to read. "
    } ]
  }, {
    "tStartMs": 21716,
    "dDurationMs": 6507,
    "segs": [ {
      "utf8": "But the bitter truth we critics must face, \nis that in the grand scheme of things,"
    } ]
  }, {
    "tStartMs": 28223,
    "dDurationMs": 7367,
    "segs": [ {
      "utf8": "the average piece of junk is probably more \nmeaningful than our criticism designating it so."
    } ]
  }, {
    "tStartMs": 36065,
    "dDurationMs": 4208,
    "segs": [ {
      "utf8": "But there are times \nwhen a critic truly risks something,"
    } ]
  }, {
    "tStartMs": 40273,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and that is in the discovery \nand defense of the new."
    } ]
  }, {
    "tStartMs": 44707,
    "dDurationMs": 4774,
    "segs": [ {
      "utf8": "The world is often unkind \nto new talent, new creations."
    } ]
  }, {
    "tStartMs": 49481,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "The new needs friends."
    } ]
  }, {
    "tStartMs": 52301,
    "dDurationMs": 3699,
    "segs": [ {
      "utf8": "Last night, I experienced something new,"
    } ]
  }, {
    "tStartMs": 56000,
    "dDurationMs": 5098,
    "segs": [ {
      "utf8": "an extraordinary meal \nfrom a singularly unexpected source."
    } ]
  }, {
    "tStartMs": 61331,
    "dDurationMs": 2987,
    "segs": [ {
      "utf8": "To say that both the meal \nand its maker have challenged"
    } ]
  }, {
    "tStartMs": 64318,
    "dDurationMs": 6199,
    "segs": [ {
      "utf8": "my preconceptions about fine cooking \nis a gross understatement."
    } ]
  }, {
    "tStartMs": 70645,
    "dDurationMs": 3206,
    "segs": [ {
      "utf8": "They have rocked me to my core."
    } ]
  }, {
    "tStartMs": 74469,
    "dDurationMs": 6601,
    "segs": [ {
      "utf8": "In the past, I have made no secret of my disdain\nfor Chef Gusteau's famous motto:"
    } ]
  }, {
    "tStartMs": 81070,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "\"Anyone can cook.\""
    } ]
  }, {
    "tStartMs": 83447,
    "dDurationMs": 6189,
    "segs": [ {
      "utf8": "But I realize, only now do I \ntruly understand what he meant. "
    } ]
  }, {
    "tStartMs": 89907,
    "dDurationMs": 8577,
    "segs": [ {
      "utf8": "Not everyone can become a great artist, \nbut a great artist can come from anywhere."
    } ]
  }, {
    "tStartMs": 98959,
    "dDurationMs": 7287,
    "segs": [ {
      "utf8": "It is difficult to imagine more humble origins than \nthose of the genius now cooking at Gusteau's,"
    } ]
  }, {
    "tStartMs": 106246,
    "dDurationMs": 7276,
    "segs": [ {
      "utf8": "who is, in this critic's opinion, \nnothing less than the finest chef in France."
    } ]
  }, {
    "tStartMs": 113658,
    "dDurationMs": 5278,
    "segs": [ {
      "utf8": "I will be returning to Gusteau's soon, \nhungry for more."
    } ]
  } ]
}
