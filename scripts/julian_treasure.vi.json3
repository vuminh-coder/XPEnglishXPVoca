    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 401887,
    "dDurationMs": 1904,
    "segs": [ {
      "utf8": "Em để chìa khóa của anh ở đâu?"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 403791,
    "dDurationMs": 1903,
    "segs": [ {
      "utf8": "Ý nghĩa của hai câu nói \nhơi khác nhau"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 405694,
    "dDurationMs": 1966,
    "segs": [ {
      "utf8": "qua hai cách nói này."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 407660,
    "dDurationMs": 2246,
    "segs": [ {
      "utf8": "Và cuối cùng, cường độ."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 409906,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "Tôi có thể rất hào hứng\nbằng cách dùng cường độ."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 413307,
    "dDurationMs": 2177,
    "segs": [ {
      "utf8": "Xin lỗi nếu tôi \nlàm ai đó giật mình."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 415484,
    "dDurationMs": 2311,
    "segs": [ {
      "utf8": "Hoặc, tôi có thể \nkhiến bạn thật sự chú ý"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 417795,
    "dDurationMs": 2051,
    "segs": [ {
      "utf8": "bằng cách nói rất khẽ."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 419846,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "Có vài người \nlúc nào cũng phát sóng."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 421931,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "Hãy cố đừng làm thế."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 423404,
    "dDurationMs": 3359,
    "segs": [ {
      "utf8": "Đấy gọi là \nlấy thịt đè người,"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 426763,
    "dDurationMs": 2616,
    "segs": [ {
      "utf8": "áp đặt âm thanh của bạn\nlên người xung quanh"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 429379,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "cách vô tâm và bất cẩn. \nKhông tốt."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 432419,
    "dDurationMs": 2656,
    "segs": [ {
      "utf8": "Dĩ nhiên, khi vận dụng\ntất cả những điều này"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 435075,
    "dDurationMs": 2328,
    "segs": [ {
      "utf8": "là khi bạn phải nói\nđiều gì đó quan trọng."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 437403,
    "dDurationMs": 1636,
    "segs": [ {
      "utf8": "Có thể là \nđứng trên sân khấu"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 439039,
    "dDurationMs": 1475,
    "segs": [ {
      "utf8": "và diễn thuyết \ntrước khán giả."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 440514,
    "dDurationMs": 2529,
    "segs": [ {
      "utf8": "Có thể là cầu hôn,"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 443043,
    "dDurationMs": 3154,
    "segs": [ {
      "utf8": "đề nghị tăng lương,\nphát biểu ở hôn lễ."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 446197,
    "dDurationMs": 2006,
    "segs": [ {
      "utf8": "Sự kiện nào đi nữa,\nnếu nó rất quan trọng,"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 448203,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "bạn tự thấy mình\ncần đến công cụ này"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 451683,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "và cỗ máy sẽ được vặn lên,"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 454013,
    "dDurationMs": 3095,
    "segs": [ {
      "utf8": "và không máy nào chạy tốt\nnếu không được làm ấm."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 457108,
    "dDurationMs": 1976,
    "segs": [ {
      "utf8": "Hãy làm ấm giọng bạn."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 459084,
    "dDurationMs": 1848,
    "segs": [ {
      "utf8": "Hãy để tôi chỉ cách."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 460932,
    "dDurationMs": 3108,
    "segs": [ {
      "utf8": "Các bạn có thể cùng\nđứng lên một lát không?"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 464040,
    "dDurationMs": 2916,
    "segs": [ {
      "utf8": "Tôi sẽ chỉ bạn sáu bài\nkhởi động giọng nói"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 466956,
    "dDurationMs": 3473,
    "segs": [ {
      "utf8": "mà tôi luôn làm \ntrước mỗi bài diễn thuyết."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 470429,
    "dDurationMs": 2771,
    "segs": [ {
      "utf8": "Khi sắp nói với ai quan trọng,\nhãy làm như sau"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 473200,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "Đầu tiên, hai tay dơ lên, \nhít sâu,"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 476166,
    "dDurationMs": 3102,
    "segs": [ {
      "utf8": "và thở ra, \nahhhhh, như thế."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 479268,
    "dDurationMs": 1628,
    "segs": [ {
      "utf8": "Một lần nữa nào."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 480896,
    "dDurationMs": 2998,
    "segs": [ {
      "utf8": "Ahhhh, rất tốt."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 483894,
    "dDurationMs": 1742,
    "segs": [ {
      "utf8": "Giờ chúng ta sẽ làm ấm môi."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 485636,
    "dDurationMs": 2352,
    "segs": [ {
      "utf8": "Nào hãy nói ba, ba, ba, ba,"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 487988,
    "dDurationMs": 2952,
    "segs": [ {
      "utf8": "ba, ba, ba, ba. Rất tốt."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 490940,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Và bây giờ, brrrrrrrrrr,"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 494380,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "y như lúc bạn \ncòn là trẻ con."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 495830,
    "dDurationMs": 2527,
    "segs": [ {
      "utf8": "Brrrr. Giờ thì môi bạn \nđầy sức sống."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 498357,
    "dDurationMs": 1575,
    "segs": [ {
      "utf8": "Tiếp đến là bài tập lưỡi"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 499932,
    "dDurationMs": 4422,
    "segs": [ {
      "utf8": "bằng cách cường điệu\nla, la, la, la, la, la, la, la, la."
    } ],
    "wpWinPosId": 4,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 504354,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "Giỏi. Bạn làm rất tốt."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 505864,
    "dDurationMs": 3595,
    "segs": [ {
      "utf8": "Và rồi, cuốn lưỡi \nthành chữ R. Rrrrrrr."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 509459,
    "dDurationMs": 2216,
    "segs": [ {
      "utf8": "Giống như thấm rượu \nsâm banh cho lưỡi."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 511675,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Cuối cùng, \ntôi sẽ làm mẫu một lần,"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 513995,
    "dDurationMs": 1807,
    "segs": [ {
      "utf8": "dân chuyên gọi đây là tiếng còi."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 515802,
    "dDurationMs": 2433,
    "segs": [ {
      "utf8": "Cách này rất tốt. Nó đi từ\nchữ “we” đến chữ “aw”,"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 518235,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "“we” cao, “aw” thấp."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 519495,
    "dDurationMs": 6715,
    "segs": [ {
      "utf8": "Nào ta bắt đầu, \nweeeaawww, weeeaawww."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 526210,
    "dDurationMs": 2176,
    "segs": [ {
      "utf8": "Tuyệt. Hãy cho bạn \nmột tràng pháo tay."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 528386,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "Mời mọi người ngồi, \nxin cảm ơn. (Vỗ tay)"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 531216,
    "dDurationMs": 2624,
    "segs": [ {
      "utf8": "Lần sau trước khi nói chuyện,\nbạn hãy làm các điều này."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 533840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Bây giờ tôi xin tổng kết."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 536480,
    "dDurationMs": 2296,
    "segs": [ {
      "utf8": "Đây là điểm quan trọng."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 538776,
    "dDurationMs": 1831,
    "segs": [ {
      "utf8": "Đây là tình trạng của chúng ta, \nđúng không?"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 540607,
    "dDurationMs": 1665,
    "segs": [ {
      "utf8": "Chúng ta nói không được tốt,"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 542272,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "với người không lắng nghe,"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 543640,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "trong một môi trường\nđầy tiếng ồn và tạp âm."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 546559,
    "dDurationMs": 2065,
    "segs": [ {
      "utf8": "Tôi đã nói điều đó \ntrên diễn đàn này"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 548624,
    "dDurationMs": 1678,
    "segs": [ {
      "utf8": "vào những lúc khác nhau."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 550302,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "Thế giới sẽ ra sao"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 551936,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "nếu ta nói mạnh mẽ hơn"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 553656,
    "dDurationMs": 2056,
    "segs": [ {
      "utf8": "với những người\nchăm chú lắng nghe"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 555712,
    "dDurationMs": 3394,
    "segs": [ {
      "utf8": "trong một môi trường \nthích hợp để trò chuyện?"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 559106,
    "dDurationMs": 2983,
    "segs": [ {
      "utf8": "Nhìn rộng hơn,"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 562089,
    "dDurationMs": 1097,
    "segs": [ {
      "utf8": "thế giới sẽ ra sao"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 563186,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "nếu ta tạo ra thanh âm\nmột cách có ý thức"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 565814,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "và lắng nghe âm thanh \nmột cách có ý thức"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 567847,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "và thiết kế không gian"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 569474,
    "dDurationMs": 1477,
    "segs": [ {
      "utf8": "một cách có ý thức \ncho việc chuyện trò?"
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 570951,
    "dDurationMs": 3224,
    "segs": [ {
      "utf8": "Thế giới ấy nghe thật tuyệt,"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 574175,
    "dDurationMs": 1896,
    "segs": [ {
      "utf8": "một thế giới lấy hiểu biết"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 576071,
    "dDurationMs": 2015,
    "segs": [ {
      "utf8": "làm tiêu chuẩn cho mình,"
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 2
  }, {
    "tStartMs": 578086,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "đó là một ý tưởng đáng sẻ chia."
